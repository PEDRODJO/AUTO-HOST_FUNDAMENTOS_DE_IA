PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
PASSWORD_PEPPER=replace-with-your-private-long-random-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=TallerDB2
DB_USER=taller_api_user
DB_PASSWORD=replace-with-your-mysql-password
DB_CONNECTION_LIMIT=10
FRONTEND_BASE_URL=http://localhost:3000

# Local email testing uses Ethereal.
MAIL_MODE=ethereal
EMAIL_FROM=Gestión de Talleres <no-reply@taller.local>
ETHEREAL_USER=
ETHEREAL_PASS=
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
